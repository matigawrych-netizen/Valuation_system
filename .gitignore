node_modules/
.env

# Dane NIE trafiają do repozytorium (883 MB; ceny Yahoo i część serii FRED nie mogą być publikowane).
# Wyjątek: skład indeksu w czasie — mały i potrzebny do odtworzenia uniwersum.
data/*
!data/meta/
data/meta/*
!data/meta/index_membership.json
# Zdarzenia końcowe z SEC: 1,3 MB danych publicznych, których nie da się odtworzyć bez pobrania 800 MB z EDGAR
!data/meta/sec-events.json

# Zrzuty stron Wikipedii/SEC użyte jednorazowo przy budowie składu indeksu
archive/scraping/

# Artefakty są generowane — z wyjątkiem logu sejfu holdout, który jest ścieżką audytu i MUSI być w repo
artifacts/*
!artifacts/holdout_log.json
!artifacts/sec-events-report.md
!artifacts/facts-report.md
!artifacts/facts-stability.md
!artifacts/facts.json
!artifacts/bands-calibration.json
!artifacts/facts-panel-stats.json
# Raporty pełnego uniwersum (małe pliki; same dane leżą poza repo, w UNIVERSE_DATA_DIR)
!artifacts/universe/
!artifacts/holdout_log.archived-*.json
